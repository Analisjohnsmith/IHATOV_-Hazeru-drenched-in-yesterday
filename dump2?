    for string, target_freq in TARGET.items():
        # Start out of tune by ±10 Hz
        freq = target_freq + random.uniform(-10, 10)
        print(f"\nTuning {string} (target {target_freq:.2f} Hz)")
        print(f"Starting frequency: {freq:.2f} Hz")

        # Simulate tuning adjustments
        while abs(freq - target_freq) > 0.1:
            adjustment = (target_freq - freq) * random.uniform(0.1, 0.3)
            freq += adjustment
            print(f"  Adjusting... {freq:.2f} Hz")
            time.sleep(0.1)   # slow it down for readability

        print(f"{string} tuned! Final frequency: {freq:.2f} Hz")

