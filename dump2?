# simple_ascii_waveform.py

import math

WIDTH = 80    # characters per line
HEIGHT = 20   # number of rows
CYCLES = 2    # how many wave cycles to draw

for row in range(HEIGHT):
    # compute a horizontal slice of the waveform
    line = []
    for x in range(WIDTH):
        # normalized position along x
        t = (x / WIDTH) * (2 * math.pi * CYCLES)
        # sine value in [-1, 1]
        y = math.sin(t)
        # map sine to row index (invert so top=1, bottom=-1)
        pos = int((1 - y) * (HEIGHT - 1) / 2)
        # place '*' only on the current row
        line.append('*' if pos == row else ' ')
    print("".join(line))

