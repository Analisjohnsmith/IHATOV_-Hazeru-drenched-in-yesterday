            variant: ShipVariant::AscenderPrime,
            scale: "medium".into(),
            recursion_depth: 3,
            crew_count: 3,
            style: "anime_elves_space_cadet".into(),
            seed: None,
        }
    }
}

fn scale_params(scale: &str) -> (f64, usize) {
    match scale {
        "small" => (1.1, 2),
        "large" => (1.3, 4),
        _       => (1.2, 3),
    }
}

pub fn generate_spacecraft(spec: &SpacecraftSpec) -> FractalLoomAscender {
    let mut rng = match spec.seed {
        Some(s) => StdRng::seed_from_u64(s),
        None    => StdRng::from_entropy(),
    };

    let (gf, forks) = scale_params(&spec.scale);
    let mut ship = FractalLoomAscender::new(&spec.name, spec.variant);
    ship.recursion_layer = crate::types::RecursionLayer::Rl0Physical;

    for _ in 0..spec.recursion_depth {
        ship.hull.grow_forward(gf, forks);
    }

    // Daemons
    let puff_spots  = ["Weft Corridor", "Observation Niche", "Quiet Loom-Pocket"];
    let blaze_spots = ["Loom-Chamber rail", "Warp Vault beam", "Deck Ramp Edge"];
    let dusty_spots = ["Warp Vault", "Soft Node Garden", "Meditation Pocket"];

    let puff  = DaemonCat::new("Puff",  "stability",    puff_spots.choose(&mut rng).unwrap());
    let blaze = DaemonCat::new("Blaze", "acceleration", blaze_spots.choose(&mut rng).unwrap());
    let dusty = DaemonCat::new("Dusty", "harmony",      dusty_spots.choose(&mut rng).unwrap());
    ship.set_daemon_cats(puff, blaze, dusty);

    // Operator
    ship.add_crew_member(default_operator());

    // Cadets
    let hair    = ["midnight blue", "white-gold", "silver", "rose dusk"];
    let eyes    = ["violet", "emerald", "aqua", "amber"];
    let accents = ["indigo", "emerald", "teal", "rose_gold"];
    let crystals = ["indigo", "emerald", "amethyst", "aqua"];
    let tones    = [EmotionalTone::Curious, EmotionalTone::Exhilarated, EmotionalTone::Calm];

    for i in 0..spec.crew_count {
        let cadet = CrewMember {
            name: format!("Cadet-{}", i + 1),
            role: MissionRole::Cadet,
            species: "Elf".into(),
            age: rng.gen_range(16..=21),
            anime_style: spec.style.clone(),
            hair_color: (*hair.choose(&mut rng).unwrap()).into(),
            eye_color: (*eyes.choose(&mut rng).unwrap()).into(),
            uniform_accent_color: (*accents.choose(&mut rng).unwrap()).into(),
            crystal_necklace: Some(CrystalNecklace::new(
                crystals.choose(&mut rng).unwrap(),
                1.0 + rng.gen::<f64>(),
                "Cadet crystal tuned to Loom-field resonance.",
            )),
            emotional_tone: *tones.choose(&mut rng).unwrap(),
        };
        ship.add_crew_member(cadet);
    }

    // Awaken
    if let Some(op) = ship.operator().cloned() {
        ship.three_thread_invocation(&op);
        let summary = format!(
            "Spacecraft generated from spec: name={}, scale={}, depth={}, crew={}",
            spec.name, spec.scale, spec.recursion_depth, spec.crew_count
        );
        ship.log("None", &op, &summary);
    }

    ship
}
