    pub persona: MimicPersona,
    pub memory: MimicMemory,
}

impl MimicAI {
    pub fn new(persona: MimicPersona) -> Self { Self { persona, memory: MimicMemory::new() } }

    fn score_input(&self, text: &str) -> InputMetrics {
        InputMetrics {
            length: text.split_whitespace().count(),
            is_question: text.contains('?'),
            is_excited: text.contains('!'),
        }
    }

    fn choose_tone(&self, m: &InputMetrics) -> Tone {
        if m.is_question && self.persona.precision > 0.5 { return Tone::Explanatory; }
        if m.is_excited  && self.persona.warmth    > 0.5 { return Tone::Encouraging; }
        if self.persona.creativity > 0.7 { return Tone::Imaginative; }
        Tone::Neutral
    }

    fn generate_response(&self, text: &str, tone: Tone) -> String {
        match tone {
            Tone::Explanatory => format!("It sounds like you are asking about: '{}'. Let's break it down step by step.", text),
            Tone::Encouraging => format!("That feels charged and important: '{}'. You're onto something—let's explore it further.", text),
            Tone::Imaginative => format!("Imagine this: '{}' as a starting point for a whole new world of patterns and meanings.", text),
            Tone::Neutral     => format!("I hear: '{}'. Tell me more so I can refine the pattern.", text),
        }
    }

    pub fn reply(&mut self, user_input: &str) -> String {
        let metrics = self.score_input(user_input);
        let tone = self.choose_tone(&metrics);
        let response = self.generate_response(user_input, tone);
        self.memory.add(user_input, &response);
        response
    }
}
