def dsond_combined_fields(event: dict):
    """Combine global + orb + player + sovereign noise fields for an event."""
    node = DSOND_SESSION["nodes"].get(event.get("target"))
    player = DSOND_SESSION["players"].get(event.get("actor"))
    if node is None or player is None:
        return None

    sov = DSOND_SESSION["sovereign_overlays"].get(node["sovereign_lane"], {})
    glob = DSOND_SESSION["global_noise"]

    combined_detune = (
        glob["detune_field"]
        + node["detune_field"]
        + player["detune_bias"]
        + sov.get("detune_field", 0.0)
    )
    combined_phase_noise = (
        glob["phase_noise"]
        + node["phase_noise"]
        + player["phase_bias"]
        + sov.get("phase_noise", 0.0)
    )
    combined_glitch_prob = (
        glob["glitch_prob"]
        + node["glitch_prob"]
        + sov.get("glitch_prob", 0.0)
    )

    glitch_roll = random.random()
    is_glitch = glitch_roll < combined_glitch_prob

    return {
        "actor": event.get("actor"),
        "orb_id": event.get("target"),
        "lane": node["sovereign_lane"],
        "combined_detune": combined_detune,
        "combined_phase_noise": combined_phase_noise,
        "combined_glitch_prob": combined_glitch_prob,
        "is_glitch": is_glitch,
        "break_mode": node["break_mode"] if is_glitch else None,
        "discord_id": node["discord_id"],
        "carrier": node["chaotic_carrier"] if not is_glitch else sov.get("break_mode"),
    }


