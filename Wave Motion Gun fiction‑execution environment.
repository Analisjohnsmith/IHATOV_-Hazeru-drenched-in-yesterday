    }

    // Awaken
    if let Some(op) = ship.operator().cloned() {
        ship.three_thread_invocation(&op);
        let summary = format!(
            "Spacecraft generated from spec: name={}, scale={}, depth={}, crew={}",
            spec.name, spec.scale, spec.recursion_depth, spec.crew_count
        );
        ship.log("None", &op, &summary);
    }

    ship
}
