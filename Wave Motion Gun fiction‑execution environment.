#[derive(Debug)]
pub struct FractalLoomAscender {
    pub name: String,
    pub variant: ShipVariant,
    pub hull: SpiralBranchHull,
    pub validator: MetaTessellateValidator,
    pub field_state: TopologyFieldState,
    pub mission_log: MissionLog,
    pub recursion_layer: RecursionLayer,
    pub crew: Vec<CrewMember>,
    pub daemons: HashMap<String, DaemonCat>,
    pub glyph_emitters: Vec<Glyph>,
}

impl FractalLoomAscender {
    pub fn new(name: &str, variant: ShipVariant) -> Self {
        Self {
            name: name.into(),
            variant,
            hull: SpiralBranchHull::default(),
            validator: MetaTessellateValidator::default(),
            field_state: TopologyFieldState::default(),
            mission_log: MissionLog::new(),
            recursion_layer: RecursionLayer::Rl0Physical,
            crew: Vec::new(),
            daemons: HashMap::new(),
            glyph_emitters: Vec::new(),
        }
    }

    // ---------- Crew & Daemons ----------

    pub fn add_crew_member(&mut self, m: CrewMember) { self.crew.push(m); }

    pub fn set_daemon_cats(&mut self, puff: DaemonCat, blaze: DaemonCat, dusty: DaemonCat) {
        self.daemons.insert("Puff".into(), puff);
        self.daemons.insert("Blaze".into(), blaze);
        self.daemons.insert("Dusty".into(), dusty);
    }

    fn find_operator(&self) -> Option<&CrewMember> {
        self.crew.iter().find(|c| c.role == MissionRole::Operator)
    }

    // ---------- Maneuvers ----------

    pub fn spiral_thrust(&mut self, operator: &CrewMember) {
        let tone = operator.current_tone();
        self.validator.evaluate(self.recursion_layer, tone);
        self.hull.grow_forward(1.15, 2);
        self.field_state.fold(0.05);
        self.log("Medium", operator, "Spiral thrust executed.");
    }

    pub fn branch_jump(&mut self, operator: &CrewMember) {
        let tone = operator.current_tone();
        self.validator.evaluate(self.recursion_layer, tone);
        self.hull.grow_forward(1.4, 3);
        self.field_state.fray(0.1);
        self.log("High", operator, "Branch-jump maneuver performed.");
    }

    pub fn collapse_pulse(&mut self, operator: &CrewMember) {
        self.hull.collapse_to_trunk();
        self.field_state.harmonize(0.2);
        self.log("Low", operator, "Collapse-pulse used to decelerate and stabilize.");
    }

    pub fn topology_weave_jump(&mut self, operator: &CrewMember, target_description: &str) {
        let tone = operator.current_tone();
        self.validator.evaluate(self.recursion_layer, tone);
        match tone {
            EmotionalTone::Curious | EmotionalTone::Exhilarated => {
                self.recursion_layer = RecursionLayer::Rl2Mythic;
                self.field_state.fold(0.2);
            }
            EmotionalTone::Focused => {
                self.recursion_layer = RecursionLayer::Rl3Archetypal;
                self.field_state.fold(0.3);
            }
            _ => {}
        }
        self.hull.bloom(1.5, 4);
        self.field_state.bloom_factor = (self.field_state.bloom_factor + 0.5).min(1.0);
        let summary = format!(
            "Topology weave jump to: {} (layer={}).",
            target_description,
            self.recursion_layer.name()
        );
        self.log("High", operator, &summary);
    }

    // ---------- Glyph emission ----------

    pub fn emit_glyph(&mut self, glyph: Glyph, operator: &CrewMember, reason: &str) {
        let mut ctx = GlyphContext::default();
        glyph.apply(&mut ctx);
        match glyph.glyph_type {
            GlyphType::Weft => self.field_state.harmonize(glyph.intensity * 0.1),
            GlyphType::Fray => self.field_state.fray(glyph.intensity * 0.1),
            GlyphType::Knot => self.field_state.fold(glyph.intensity * 0.1),
            _ => {}
        }
        self.glyph_emitters.push(glyph.clone());
        let summary = format!(
            "Glyph emitted: {}, ctx=[bias {:.2}, stab {:.2}, chaos {:.2}, harm {:.2}, struct {:.2}]",
            reason, ctx.directional_bias, ctx.stability, ctx.chaos, ctx.harmony, ctx.structure
        );
        self.log(&format!("Glyph-{}", glyph.glyph_type.as_str()), operator, &summary);
    }

    pub fn defense_fray_burst(&mut self, operator: &CrewMember) {
        let g = Glyph::new(GlyphType::Fray, 1.0, "FrayBurst defense");
        self.emit_glyph(g, operator, "FrayBurst defense triggered.");
    }

    pub fn defense_knot_shield(&mut self, operator: &CrewMember) {
        let g = Glyph::new(GlyphType::Knot, 1.0, "Knot shielding");
        self.emit_glyph(g, operator, "Knot shielding activated.");
    }

    // ---------- Daemon influence ----------

    pub fn apply_daemon_influence(&mut self) {
        // Collect influences to avoid double borrow.
        let aspects: Vec<String> = self.daemons.values().map(|d| d.aspect.clone()).collect();
        for aspect in aspects {
            match aspect.as_str() {
                "stability" => self.field_state.harmonize(0.1),
                "acceleration" => {
                    self.field_state.fray(0.05);
                    self.field_state.fold(0.05);
                }
                "harmony" => self.field_state.harmonize(0.2),
                _ => {}
            }
        }
    }

    // ---------- Ritual ----------

    pub fn three_thread_invocation(&mut self, operator: &CrewMember) {
        self.hull.collapse_to_trunk();
        self.field_state.harmonize(0.3);
        self.log("Low", operator, "Three-thread invocation performed. Ship awakened.");
    }

    // ---------- Logging helper ----------

    pub fn log(&mut self, glyph_activity: &str, operator: &CrewMember, summary: &str) {
        let daemon_status: HashMap<String, String> = self
            .daemons
            .iter()
            .map(|(k, d)| (k.clone(), d.aspect.clone()))
            .collect();

        self.mission_log.log_event(
            self.recursion_layer,
            self.hull.branch_state,
            &self.field_state,
            glyph_activity,
            daemon_status,
            operator.current_tone(),
            summary,
        );
    }

    // Convenience for the demo driver.
    pub fn operator(&self) -> Option<&CrewMember> { self.find_operator() }
}

