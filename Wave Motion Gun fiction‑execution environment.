pub type Point2 = (f64, f64);

pub fn generate_grid(nx: usize, ny: usize, width: f64, height: f64) -> Vec<Point2> {
    let mut points = Vec::with_capacity(nx * ny);
    let dx = (nx.max(2) - 1) as f64;
    let dy = (ny.max(2) - 1) as f64;
    for i in 0..nx {
        for j in 0..ny {
            points.push(((i as f64 / dx) * width, (j as f64 / dy) * height));
        }
    }
    points
}

pub fn apply_pattern<F: Fn(Point2) -> f64>(points: &[Point2], f: F) -> Vec<f64> {
    points.iter().map(|&p| f(p)).collect()
}

pub fn radial_wave(p: Point2) -> f64 {
    let (x, y) = p;
    let r = (x*x + y*y).sqrt();
    0.5 + 0.5 * r.sin()
}
