    pub layers: HashMap<String, HashMap<String, Value>>,
}

impl LayeredState {
    pub fn new() -> Self { Self::default() }

    pub fn set(&mut self, layer: &str, key: &str, value: Value) {
        self.layers.entry(layer.to_string()).or_default().insert(key.to_string(), value);
