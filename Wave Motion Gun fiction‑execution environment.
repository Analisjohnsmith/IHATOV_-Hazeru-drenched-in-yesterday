        )
        for i in range(len(shapes))
    ]

    for node in nodes:
        node.check_invariants()
        node.emit()
        for _ in range(len(node.states)):
            node.transition()
        for level in [0.1, 0.3, 0.5, 0.7, 0.9, 1.0]:
            node.perturb(f"perturb@{level}")
        node.check_invariants()

    return ledger.dump()


