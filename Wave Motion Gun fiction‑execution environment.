# SECTION 8: HSONh Harmonic Overlay
# ==========================================================

def apply_harmonic(t, h):
    freq = h["frequency"]
    phase = h.get("phase_shift", 0.0)
    decay = h.get("decay", 0.0)
    resonance = h.get("resonance", 1.0)
    carrier = h.get("carrier", "sine")

    base = 0.0
    omega = 2 * math.pi * freq * t + phase

    if carrier == "sine":
        base = math.sin(omega)
    elif carrier == "square":
        base = 1.0 if math.sin(omega) >= 0 else -1.0
    elif carrier == "saw":
        base = 2.0 * (t * freq - math.floor(0.5 + t * freq))
    else:
        base = math.sin(omega)

    amplitude = resonance * math.exp(-decay * t)
    return amplitude * base


# ==========================================================
# SECTION 9: DSONd Disharmonic Overlay
# ==========================================================

def apply_disharmonic(t, harmonic_value, d):
    v = harmonic_value

    detune = d.get("detune", 0.0)
    phase_noise = d.get("phase_noise", 0.0)
    glitch_prob = d.get("glitch_prob", 0.0)
    decay_noise = d.get("decay_noise", 0.0)
    break_mode = d.get("break_mode", "clip")
    carrier = d.get("carrier", None)

    if carrier == "chaos":
        chaos_factor = math.sin(13.0 * t) * math.cos(7.0 * t)
        v *= (1.0 + chaos_factor)

    v *= (1.0 + detune)

    jitter = phase_noise * (random.random() * 2 - 1)
    v = v * math.cos(jitter)

    if random.random() < glitch_prob:
        if break_mode == "stall":
            v = 0.0
        elif break_mode == "invert":
            v = -v
        elif break_mode == "explode":
            v *= 5.0

    noise_factor = 1 + decay_noise * (random.random() * 2 - 1)
    v *= max(noise_factor, 0.0)

    if break_mode == "clip":
        v = max(min(v, 1.0), -1.0)

    return v


# ==========================================================
# SECTION 10: All-Layer Runtime (Chemo-SN + HSONh + DSONd)
# ==========================================================

def run_all_layers(t, node):
    h = node.get("HSONh")
    d = node.get("DSONd")

    if not h:
        return 0.0

    harmonic = apply_harmonic(t, h)

    if not d:
        return harmonic

    return apply_disharmonic(t, harmonic, d)


