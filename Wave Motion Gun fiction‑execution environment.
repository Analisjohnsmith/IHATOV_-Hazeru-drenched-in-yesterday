def sha(x: dict) -> str:
    return hashlib.sha256(json.dumps(x, sort_keys=True).encode()).hexdigest()


# ==========================================================
# SECTION 2: Ledger (Append-Only Event Log)
# ==========================================================

class Ledger:
    def __init__(self):
        self.entries = []

    def log(self, event, data):
        self.entries.append({
            "event": event,
            "ts": datetime.utcnow().isoformat(),
            "data": data
        })

    def dump(self) -> str:
        return json.dumps(self.entries, indent=2)


