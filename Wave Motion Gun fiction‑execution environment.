pub fn ship_from_hjson_str(text: &str) -> Result<FractalLoomAscender, deser_hjson::Error> {
    let cfg: ShipConfig = deser_hjson::from_str(text)?;

    let variant = ShipVariant::parse(&cfg.variant).unwrap_or(ShipVariant::AscenderPrime);
    let mut ship = FractalLoomAscender::new(&cfg.name, variant);

    ship.hull.branch_state = match cfg.hull.branch_state.as_str() {
        "spiral"   => BranchState::Spiral,
        "fork"     => BranchState::Fork,
        "return"   => BranchState::Return,
        "collapse" => BranchState::Collapse,
        "bloom"    => BranchState::Bloom,
        _          => BranchState::Trunk,
    };

    // Rebuild the trunk geometry to match the requested growth.
    for _ in 0..cfg.validator.recursion_depth {
        ship.hull.grow_forward(cfg.hull.growth_factor, cfg.hull.forks);
    }

    ship.recursion_layer =
        RecursionLayer::from_name(&cfg.recursion_layer).unwrap_or(RecursionLayer::Rl0Physical);

    ship.validator.mode = match cfg.validator.mode.as_str() {
        "triangle" => crate::types::ValidatorMode::Triangle,
        "pentagon" => crate::types::ValidatorMode::Pentagon,
        "octagon"  => crate::types::ValidatorMode::Octagon,
        "void"     => crate::types::ValidatorMode::Void,
        _          => crate::types::ValidatorMode::Fractal,
    };
    ship.validator.recursion_depth = cfg.validator.recursion_depth;
    ship.validator.field_pressure = cfg.validator.field_pressure;
    ship.validator.operator_intention = cfg.validator.operator_intention.clone();
    ship.validator.daemon_alignment = DaemonAlignment {
        puff:  cfg.validator.daemon_alignment.puff,
        blaze: cfg.validator.daemon_alignment.blaze,
        dusty: cfg.validator.daemon_alignment.dusty,
    };

    ship.field_state.smoothness    = cfg.field_state.smoothness;
    ship.field_state.fray_level    = cfg.field_state.fray_level;
    ship.field_state.knot_density  = cfg.field_state.knot_density;
    ship.field_state.bloom_factor  = cfg.field_state.bloom_factor;

    for c in cfg.crew {
        let necklace = c.crystal_necklace.map(|n| CrystalNecklace::new(&n.color, n.resonance, &n.description));
        let tone = EmotionalTone::from_upper(&c.emotional_tone).unwrap_or(EmotionalTone::Curious);
        let role = MissionRole::parse(&c.role).unwrap_or(MissionRole::Guest);

        ship.add_crew_member(CrewMember {
            name: c.name,
            role,
            species: c.species,
            age: 18,
            anime_style: c.anime_style,
            hair_color: c.hair_color,
            eye_color: c.eye_color,
            uniform_accent_color: c.uniform_accent_color,
            crystal_necklace: necklace,
            emotional_tone: tone,
        });
    }

    for (name, d) in cfg.daemons {
        ship.daemons.insert(name.clone(), DaemonCat::new(&name, &d.aspect, &d.favorite_spot));
    }

    Ok(ship)
}

pub fn ship_from_hjson_file<P: AsRef<Path>>(path: P) -> Result<FractalLoomAscender, std::io::Error> {
