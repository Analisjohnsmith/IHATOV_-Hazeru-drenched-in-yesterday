use crate::types::BranchState;
use std::f64::consts::PI;

#[derive(Debug, Clone)]
pub struct BranchNode {
    pub depth: u32,
    pub angle: f64,
    pub length: f64,
    pub children: Vec<BranchNode>,
}

impl BranchNode {
    pub fn root() -> Self { Self { depth: 0, angle: 0.0, length: 1.0, children: Vec::new() } }

    pub fn tip(&self) -> (f64, f64) {
        (self.length * self.angle.cos(), self.length * self.angle.sin())
    }

    pub fn grow(&mut self, factor: f64, forks: usize) -> Vec<usize> {
        let spread = PI / 6.0;
        let center = (forks as f64 - 1.0) / 2.0;
        let mut new_indices = Vec::with_capacity(forks);
        let start = self.children.len();
        for i in 0..forks {
            let delta = (i as f64 - center) * spread;
            let child = BranchNode {
                depth: self.depth + 1,
                angle: self.angle + delta,
                length: self.length * factor,
                children: Vec::new(),
            };
            self.children.push(child);
            new_indices.push(start + i);
        }
        new_indices
    }
}

#[derive(Debug, Clone)]
pub struct SpiralBranchHull {
    pub trunk: BranchNode,
    pub branch_state: BranchState,
}

impl Default for SpiralBranchHull {
    fn default() -> Self {
        Self { trunk: BranchNode::root(), branch_state: BranchState::Trunk }
    }
}

impl SpiralBranchHull {
    /// Grow the frontier two layers deep per call (mirrors the Python `grow_forward`).
    pub fn grow_forward(&mut self, factor: f64, forks: usize) {
        let mut frontier: Vec<*mut BranchNode> = vec![&mut self.trunk as *mut _];
        for _ in 0..2 {
            let mut next: Vec<*mut BranchNode> = Vec::new();
            for node_ptr in frontier {
                // SAFETY: each pointer is unique within this traversal.
                let node = unsafe { &mut *node_ptr };
                let start = node.children.len();
                node.grow(factor, forks);
                for i in start..node.children.len() {
                    next.push(&mut node.children[i] as *mut _);
                }
            }
            frontier = next;
        }
        self.branch_state = BranchState::Spiral;
    }

    pub fn collapse_to_trunk(&mut self) {
        self.trunk.children.clear();
        self.branch_state = BranchState::Trunk;
    }

    pub fn bloom(&mut self, factor: f64, forks: usize) {
        self.grow_forward(factor, forks);
        self.branch_state = BranchState::Bloom;
    }
}

/// Pure recursive growth that mirrors the Haskell `growNode` / `growHullStep`.
pub fn grow_node(angle: f64, len: f64, factor: f64, forks: usize) -> Vec<(f64, f64)> {
    let spread = PI / 6.0;
    let center = (forks as f64 - 1.0) / 2.0;
    (0..forks)
        .map(|i| {
            let delta = (i as f64 - center) * spread;
            (angle + delta, len * factor)
        })
        .collect()
}
