            ship: AscenderShipScene::default(),
            egg: Egg::default(),
            unlock_zones: vec![unlock_zone],
            cosmic: CosmicIntelligence::default(),
        }
    }
}

impl SovereignRuntime {
    pub fn new() -> Self { Self::default() }

    pub fn balance_scene(&mut self) {
        let j = self.sovereigns.get("Juniper").map(|s| s.weight).unwrap_or(0.0);
        let l = self.sovereigns.get("Leela").map(|s| s.weight).unwrap_or(0.0);
        let s = self.sovereigns.get("Lee").map(|s| s.weight).unwrap_or(0.0);
        self.state.harmony = (j + l + s) / 3.0;
    }

    pub fn step(&mut self) {
        self.state.tick += 1;
        self.balance_scene();
        if self.state.harmony < 0.70 {
            self.state.imbalance += 1;
            self.state.harmony = 0.85;
        }
    }

    pub fn mission_cycle(&mut self) { self.cosmic.mission_cycle(); }

    pub fn status(&self) -> SovereignStatus {
        SovereignStatus {
            tick: self.state.tick,
            harmony: self.state.harmony,
            imbalance: self.state.imbalance,
            ui_state: self.layers.get("UI").map(|l| l.status.clone()).unwrap_or_default(),
            gi_state: self.layers.get("GI").map(|l| l.status.clone()).unwrap_or_default(),
            sovereigns: vec!["Juniper".into(), "Leela".into(), "Lee".into()],
            fields: self.cosmic.fields.iter().map(|f| f.id.clone()).collect(),
            validators: self.cosmic.validators.iter().map(|v| v.name.clone()).collect(),
        }
    }
}

