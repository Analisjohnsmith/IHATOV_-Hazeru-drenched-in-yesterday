def apply_disharmonic(t, harmonic_value, d):
    v = harmonic_value

    detune = d.get("detune", 0.0)
    phase_noise = d.get("phase_noise", 0.0)
    glitch_prob = d.get("glitch_prob", 0.0)
    decay_noise = d.get("decay_noise", 0.0)
    break_mode = d.get("break_mode", "clip")
    carrier = d.get("carrier", None)

    if carrier == "chaos":
        chaos_factor = math.sin(13.0 * t) * math.cos(7.0 * t)
        v *= (1.0 + chaos_factor)

    v *= (1.0 + detune)

    jitter = phase_noise * (random.random() * 2 - 1)
    v = v * math.cos(jitter)

    if random.random() < glitch_prob:
        if break_mode == "stall":
            v = 0.0
        elif break_mode == "invert":
            v = -v
        elif break_mode == "explode":
            v *= 5.0

    noise_factor = 1 + decay_noise * (random.random() * 2 - 1)
    v *= max(noise_factor, 0.0)

    if break_mode == "clip":
        v = max(min(v, 1.0), -1.0)

    return v


