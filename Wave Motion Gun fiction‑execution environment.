    }
}

impl TopologyFieldState {
    pub fn fold(&mut self, amount: f64) {
        self.smoothness = (self.smoothness - amount).max(0.0);
        self.knot_density = (self.knot_density + amount * 0.5).min(1.0);
    }
    pub fn harmonize(&mut self, amount: f64) {
        self.smoothness = (self.smoothness + amount).min(1.0);
        self.fray_level = (self.fray_level - amount * 0.7).max(0.0);
    }
    pub fn fray(&mut self, amount: f64) {
        self.fray_level = (self.fray_level + amount).min(1.0);
        self.smoothness = (self.smoothness - amount * 0.3).max(0.0);
    }
    pub fn describe(&self) -> &'static str {
        if self.fray_level > 0.7 { "Frayed" }
        else if self.bloom_factor > 0.5 { "Blooming" }
        else if self.knot_density > 0.7 { "Knotted" }
        else { "Smooth" }
    }
}
