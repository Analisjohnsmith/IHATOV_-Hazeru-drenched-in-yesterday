        glyph.apply(&mut ctx);
        match glyph.glyph_type {
            GlyphType::Weft => self.field_state.harmonize(glyph.intensity * 0.1),
            GlyphType::Fray => self.field_state.fray(glyph.intensity * 0.1),
            GlyphType::Knot => self.field_state.fold(glyph.intensity * 0.1),
            _ => {}
        }
        self.glyph_emitters.push(glyph.clone());
        let summary = format!(
            "Glyph emitted: {}, ctx=[bias {:.2}, stab {:.2}, chaos {:.2}, harm {:.2}, struct {:.2}]",
            reason, ctx.directional_bias, ctx.stability, ctx.chaos, ctx.harmony, ctx.structure
        );
        self.log(&format!("Glyph-{}", glyph.glyph_type.as_str()), operator, &summary);
    }

