#!/usr/bin/env python3
"""
EXECUTABLE CINEMA — A Trip to the Moon + Felix the Cat
=======================================================
No text. No titles. No dialogue. Pure visual storytelling.
Every frame is f(t). No stored pixels. Deterministic.

Scenes:
  1. Felix walks through 1920s city
  2. Felix in attic — finds telescope, sees Moon
  3. professors plan expedition (blackboard, table)
  4. Cannon launch — flame, smoke, capsule flies
  5. Space — Felix floats, stars stream, comet passes
  6. Impact — capsule hits Moon in the eye
  7. Lunar surface — Felix walks, plants flag, Earth in sky
  8. Felix waves goodbye from the Moon
"""

import argparse
import math
import subprocess
from dataclasses import dataclass
from typing import List

import numpy as np
import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt
from matplotlib.patches import Circle, Ellipse, Rectangle, Polygon


@dataclass
class FilmConfig:
    width: int = 480
    height: int = 480
    fps: int = 12
    duration: float = 28.0
    output: str = "trip_felix_moon.gif"
    seed: int = 42

    @property
    def total_frames(self) -> int:
        return int(self.duration * self.fps)


class Narrative:
    def __init__(self, cfg: FilmConfig):
        self.cfg = cfg
        self.felix_x = 0.5
        self.felix_y = 3.5
        self.felix_phase = 0.0
        self.felix_state = "walking"
        self.capsule_x = 3.0
        self.capsule_y = 3.5
        self.capsule_state = "grounded"
        self.look_angle = 0.0
        self.impact_done = False
        self.impact_time = 0.0

    def phase(self, t: float) -> str:
        d = self.cfg.duration
        if t < d * 0.18:      return "city"
        elif t < d * 0.30:    return "attic"
        elif t < d * 0.42:    return "congress"
        elif t < d * 0.55:    return "launch"
        elif t < d * 0.72:    return "space"
        elif t < d * 0.85:    return "impact"
        elif t < d * 0.95:    return "surface"
        else:                 return "wave"

    def update(self, t: float, dt: float):
        p = self.phase(t)
        self.felix_phase = t
        d = self.cfg.duration

        if p == "city":
            self.felix_x += 0.1 * dt * 12
            if self.felix_x > 10.5:
                self.felix_x = -0.5
            self.felix_y = 3.5
            self.felix_state = "walking"

        elif p == "attic":
            self.felix_x = 3.0
            self.felix_y = 3.5
            self.felix_state = "looking"
            self.look_angle = (t - d * 0.18) / (d * 0.12)

        elif p == "congress":
            self.felix_x = 1.5
            self.felix_y = 3.5
            self.felix_state = "standing"

        elif p == "launch":
            lt = (t - d * 0.42) / (d * 0.13)
            if lt < 0.4:
                self.capsule_x = 5.5
                self.capsule_y = 5.5
                self.capsule_state = "loaded"
            elif lt < 0.5:
                self.capsule_state = "firing"
            else:
                self.capsule_state = "flying"
                ft = (lt - 0.5) / 0.5
                self.capsule_x = 5.5 + ft * 8.0
                self.capsule_y = 5.5 + ft * 6.0

        elif p == "space":
            self.felix_x = 5.0 + 0.3 * math.sin(t * 0.8)
            self.felix_y = 5.0 + 0.4 * math.cos(t * 1.1)
            self.felix_state = "floating"
            self.capsule_x = self.felix_x + 1.8
            self.capsule_y = self.felix_y - 0.5

        elif p == "impact":
            it = (t - d * 0.72) / (d * 0.13)
            if it < 0.6:
                self.capsule_state = "approaching"
                ap = it / 0.6
                self.capsule_x = -1 + ap * 6.5
                self.capsule_y = 9 - ap * 3.0
                self.impact_done = False
            else:
                self.capsule_state = "embedded"
                self.capsule_x = 5.5
                self.capsule_y = 5.6
                if not self.impact_done:
                    self.impact_done = True
                    self.impact_time = t
                self.felix_x = 5.5
                self.felix_y = 6.0
                self.felix_state = "popping_out"

        elif p == "surface":
            surf_t = (t - d * 0.85) / (d * 0.10)
            self.felix_x = 4.0 + surf_t * 3.0
            self.felix_y = 3.0
            self.felix_state = "moon_walk"
            self.capsule_x = 8.5
            self.capsule_y = 2.8
            self.capsule_state = "landed"

        elif p == "wave":
            self.felix_x = 5.0
            self.felix_y = 3.5
            self.felix_state = "waving"


class Renderer:
    def __init__(self, cfg: FilmConfig):
        self.cfg = cfg
        self.rng = np.random.default_rng(cfg.seed)
        self._star_cache = None
        self._building_cache = None

    def _grain(self, ax, n=60, intens=0.04):
        for _ in range(n):
            x, y = self.rng.uniform(0, 10), self.rng.uniform(0, 10)
            b = self.rng.uniform(0, intens)
            ax.plot(x, y, '.', color=str(b), markersize=1, alpha=0.4)

    def _stars(self, ax, n=90):
        if self._star_cache is None:
            r = np.random.default_rng(42)
            self._star_cache = [(r.uniform(0, 10), r.uniform(0, 10),
                            r.uniform(0.2, 1.0)) for _ in range(n)]
        for sx, sy, sb in self._star_cache:
            ax.plot(sx, sy, '.', color='white', markersize=sb * 1.5, alpha=sb)

    def _felix(self, ax, x, y, phase, state="walking", s=1.0):
        # Body
        ax.add_patch(Ellipse((x, y), 1.0*s, 1.4*s, color='black'))
        # Head
        ax.add_patch(Circle((x, y + 1.0*s), 0.5*s, color='black'))
        # Ears
        for side in [-1, 1]:
            ax.add_patch(Polygon([
                (x + side*0.3*s, y + 1.3*s),
                (x + side*0.15*s, y + 1.9*s),
                (x, y + 1.3*s)
            ], color='black'))
        # Eyes
        for side in [-1, 1]:
            ex = x + side*0.17*s
            ey = y + 1.1*s
            ax.add_patch(Circle((ex, ey), 0.12*s, color='white'))
            pup = 0.02*s*math.sin(phase*3)
            ax.add_patch(Circle((ex+pup, ey), 0.05*s, color='black'))
        # Mouth
        mx = np.linspace(x - 0.1*s, x + 0.1*s, 12)
        my = y + 0.85*s + 0.03*s*np.sin(np.linspace(0, np.pi, 12))
        ax.plot(mx, my, 'white', linewidth=1.2)

        if state == "walking":
            lp = phase * 5
            for i, sg in enumerate([-1, 1]):
                sw = 0.25*s*math.sin(lp + i*math.pi)
                kx = x + sg*0.2*s + sw*0.4
                ky = y - 0.7*s
                fx2 = kx + sw*0.3
                fy2 = y - 1.2*s
                ax.plot([x+sg*0.15*s, kx], [y-0.5*s, ky], 'black', linewidth=2.5*s)
                ax.plot([kx, fx2], [ky, fy2], 'black', linewidth=2.5*s)
            for i, sg in enumerate([-1, 1]):
                asw = 0.2*s*math.sin(lp + i*math.pi + 0.5)
                hx = x + sg*0.6*s + asw
                hy = y + 0.2*s + asw*0.3
                ax.plot([x+sg*0.4*s, hx], [y+0.1*s, hy], 'black', linewidth=2.5*s)

        elif state == "looking":
            ax.plot([x+0.3*s, x+1.0*s], [y+0.3*s, y+1.2*s], 'black', linewidth=2.5*s)
            ax.add_patch(Circle((x+1.0*s, y+1.2*s), 0.08*s, color='black'))
            ax.plot([x-0.3*s, x-0.5*s], [y+0.3*s, y-0.1*s], 'black', linewidth=2.5*s)
            for sg in [-1, 1]:
                ax.plot([x+sg*0.15*s, x+sg*0.2*s], [y-0.5*s, y-1.2*s], 'black', linewidth=2.5*s)

        elif state == "floating":
            for sg in [-1, 1]:
                aa = phase*1.5 + sg*0.5
                ax.plot([x, x+sg*0.8*s*math.cos(aa)],
                       [y+0.2*s, y+0.5*s+0.3*s*math.sin(aa)], 'black', linewidth=2.5*s)
                la = phase*1.2 + sg*0.8
                ax.plot([x, x+sg*0.5*s*math.cos(la)],
                       [y-0.5*s, y-0.8*s+0.3*s*math.sin(la)], 'black', linewidth=2.5*s)

        elif state == "moon_walk":
            lp = phase * 3
            for i, sg in enumerate([-1, 1]):
                sw = 0.35*s*math.sin(lp + i*math.pi)
                kx = x + sg*0.2*s + sw*0.5
                ky = y - 0.7*s
                fx2 = kx + sw*0.4
                fy2 = y - 1.3*s
                ax.plot([x+sg*0.15*s, kx], [y-0.5*s, ky], 'black', linewidth=2.5*s)
                ax.plot([kx, fx2], [ky, fy2], 'black', linewidth=2.5*s)
            for sg in [-1, 1]:
                ax.plot([x+sg*0.3*s, x+sg*0.7*s],
                       [y+0.2*s, y+0.7*s+0.1*s*math.sin(phase*4)], 'black', linewidth=2.5*s)

        elif state == "standing":
            for sg in [-1, 1]:
                ax.plot([x+sg*0.15*s, x+sg*0.2*s], [y-0.5*s, y-1.2*s], 'black', linewidth=2.5*s)
                ax.plot([x+sg*0.3*s, x+sg*0.4*s], [y+0.2*s, y-0.1*s], 'black', linewidth=2.5*s)

        elif state == "popping_out":
            # Felix emerging from capsule
            ax.plot([x-0.3*s, x-0.3*s], [y-0.5*s, y+0.3*s], 'black', linewidth=2.5*s)
            ax.plot([x+0.3*s, x+0.3*s], [y-0.5*s, y+0.3*s], 'black', linewidth=2.5*s)
            for sg in [-1, 1]:
                ax.plot([x+sg*0.3*s, x+sg*0.6*s],
                       [y+0.3*s, y+0.8*s+0.1*s*math.sin(phase*4)], 'black', linewidth=2.5*s)

        elif state == "waving":
            for sg in [-1, 1]:
                ax.plot([x+sg*0.15*s, x+sg*0.2*s], [y-0.5*s, y-1.2*s], 'black', linewidth=2.5*s)
            # Arms up waving
            for sg in [-1, 1]:
                wave = 0.3*s*math.sin(phase*5)
                ax.plot([x+sg*0.3*s, x+sg*0.7*s],
                       [y+0.3*s, y+1.0*s+wave], 'black', linewidth=2.5*s)
                ax.add_patch(Circle((x+sg*0.7*s, y+1.0*s+wave), 0.08*s, color='black'))

    # ── Scene: City Street ──
