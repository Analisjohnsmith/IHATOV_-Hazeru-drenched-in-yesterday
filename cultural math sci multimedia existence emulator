# ─── Audio Synthesis (Micro-Level: Procedural Sound) ────────────────────────

class AudioSynth:
    """
    Procedural audio — generates tones/drums tied to frame index.
    For GIF output we skip actual audio, but the data structure is here
    for when you want WAV/MP4 output.
    """

    def __init__(self, config: FilmConfig):
        self.config = config
        self.rate = 22050

    def generate_tone(self, freq: float, duration: float, volume: float = 0.3) -> np.ndarray:
        t = np.linspace(0, duration, int(self.rate * duration), False)
        signal = volume * np.sin(2 * np.pi * freq * t)
        envelope = np.exp(-t * 3.0)
        return signal * envelope

    def generate_drum(self, duration: float = 0.1, volume: float = 0.5) -> np.ndarray:
        n = int(self.rate * duration)
        t = np.linspace(0, duration, n, False)
        signal = volume * np.sin(2 * np.pi * 80 * t) * np.exp(-t * 30)
        noise = np.random.randn(n) * 0.1 * np.exp(-t * 20)
        return signal + noise

    def score_for_scene(self, scene: str, t: float) -> Optional[np.ndarray]:
        if scene == "title_card":
            return self.generate_tone(261.63, 0.5, 0.2)  # C4
        elif scene == "felix_walk":
            return self.generate_tone(329.63, 0.3, 0.15)  # E4
        elif scene == "bird_ritual":
            return self.generate_drum(0.15, 0.3)
        elif scene == "launch":
            return self.generate_tone(196 + t * 50, 0.2, 0.25)  # Rising
        elif scene == "impact":
            return self.generate_drum(0.3, 0.6)
        return None


# ─── Main Render Pipeline ───────────────────────────────────────────────────

def render_film(config: FilmConfig) -> List[np.ndarray]:
    """Render all frames to memory as numpy arrays."""
    narrative = NarrativeEngine(config)
    renderer = SceneRenderer(config)
    audio = AudioSynth(config)

    frames = []
    total = config.total_frames
    dt = 1.0 / config.fps

    print(f"Rendering {total} frames ({config.duration}s @ {config.fps}fps)...")

    for i in range(total):
        t = i * dt
        narrative.update(t, dt)
        scene = narrative.get_scene_phase(t)
        dialogue = narrative.get_dialogue(t)

        # Assign dialogue to character
        if scene == "felix_walk":
            narrative.felix.dialogue = dialogue
        elif scene in ("bird_ritual", "impact"):
            narrative.dancer.dialogue = dialogue

        # Render scene module
        if scene == "title_card":
            fig = renderer.render_title_card(t, dialogue or "A TRIP TO THE MOON")
        elif scene == "felix_walk":
            fig = renderer.render_felix_scene(t, narrative.felix)
        elif scene == "bird_ritual":
            fig = renderer.render_bird_scene(t, narrative.dancer)
        elif scene == "launch":
            fig = renderer.render_launch_scene(t, narrative.capsule)
        elif scene == "space_travel":
            fig = renderer.render_space_scene(t, narrative.capsule)
        elif scene == "impact":
            fig = renderer.render_impact_scene(t, narrative.capsule)
        elif scene == "fin":
            fig = renderer.render_title_card(t, "FIN")
        else:
            fig = renderer.render_title_card(t, "...")

        # Convert figure to numpy array
        fig.canvas.draw()
        buf = fig.canvas.buffer_rgba()
        image = np.asarray(buf)[:, :, :3]  # drop alpha
        plt.close(fig)

        frames.append(image)

        if (i + 1) % 10 == 0 or i == total - 1:
            print(f"  [{i+1}/{total}] scene={scene:15s} t={t:.1f}s")

    return frames


def save_gif(frames: List[np.ndarray], output: str, fps: int):
    """Save frames as GIF using imageio."""
    import imageio
    duration = 1.0 / fps
    imageio.mimsave(output, frames, duration=duration, loop=0)
    print(f"\n  ✓ GIF saved: {output} ({len(frames)} frames, {len(frames)/fps:.1f}s)")


def save_mp4(frames: List[np.ndarray], output: str, fps: int):
    """Save frames as MP4 using ffmpeg pipe."""
    import subprocess
    import tempfile
    mp4_output = output.replace('.gif', '.mp4')
    # Write frames as raw RGB, pipe to ffmpeg
    cmd = [
        'ffmpeg', '-y',
        '-f', 'rawvideo',
        '-vcodec', 'rawvideo',
        '-pix_fmt', 'rgb24',
        '-s', f'{frames[0].shape[1]}x{frames[0].shape[0]}',
        '-r', str(fps),
        '-i', '-',
        '-c:v', 'libx264',
        '-pix_fmt', 'yuv420p',
        '-crf', '18',
        mp4_output
    ]
    proc = subprocess.Popen(cmd, stdin=subprocess.PIPE, stderr=subprocess.PIPE)
    for frame in frames:
        proc.stdin.write(frame.tobytes())
    proc.stdin.close()
    proc.wait()
    if proc.returncode == 0:
        print(f"  ✓ MP4 saved: {mp4_output}")
    else:
        print(f"  ✗ MP4 failed: {proc.stderr.read().decode()[-200:]}")


def show_preview(frames: List[np.ndarray], fps: int):
    """Display animation in live window."""
    try:
        import matplotlib.animation as animation
        fig, ax = plt.subplots(figsize=(4, 4))
        ax.axis('off')
        img = ax.imshow(frames[0])

        def update(frame_idx):
            img.set_data(frames[frame_idx])
            return [img]

        ani = animation.FuncAnimation(fig, update, frames=len(frames),
                                      interval=1000/fps, blit=True)
        plt.title("Executable Cinema — Combined Program-Movie")
        plt.show()
        return ani
    except Exception as e:
        print(f"  Preview failed: {e}")
        return None


# ─── Entry Point ────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(
        description="Executable Cinema — Combined Program-Movie"
    )
    parser.add_argument("--output", type=str, default="executable_cinema.gif")
    parser.add_argument("--duration", type=float, default=15.0)
    parser.add_argument("--fps", type=int, default=12)
    parser.add_argument("--width", type=int, default=400)
    parser.add_argument("--height", type=int, default=400)
    parser.add_argument("--preview", action="store_true")
    parser.add_argument("--mp4", action="store_true", help="Also save MP4")
    parser.add_argument("--seed", type=int, default=42)
    args = parser.parse_args()

    config = FilmConfig(
        width=args.width,
        height=args.height,
        fps=args.fps,
        duration=args.duration,
        output=args.output,
        seed=args.seed,
    )

    print("╔══════════════════════════════════════════════════╗")
    print("║  EXECUTABLE CINEMA — Combined Program-Movie     ║")
    print("║  Trip to the Moon + Felix the Cat + Bird of Paradise ║")
    print("╠══════════════════════════════════════════════════╣")
    print(f"║  Resolution: {config.width}x{config.height}                     ║")
    print(f"║  Framerate:  {config.fps} fps                            ║")
    print(f"║  Duration:   {config.duration}s                             ║")
    print(f"║  Frames:     {config.total_frames}                              ║")
    print("╚══════════════════════════════════════════════════╝")

    # Render all frames
    frames = render_film(config)

    # Save outputs
    print("\nSaving outputs...")
    save_gif(frames, config.output, config.fps)

    if args.mp4:
        save_mp4(frames, config.output, config.fps)

    if args.preview:
        print("\nOpening preview...")
        show_preview(frames, config.fps)

    # Summary
    print("\n📋 Narrative Timeline:")
    narrative = NarrativeEngine(config)
    dt = 1.0 / config.fps
    last_scene = ""
    for i in range(config.total_frames):
        t = i * dt
        scene = narrative.get_scene_phase(t)
        if scene != last_scene:
            dialogue = narrative.get_dialogue(t)
            print(f"  [{t:5.1f}s] {scene:15s} │ {dialogue}")
            last_scene = scene

    print(f"\n{'='*50}")
    print(f"  PROGRAM-MOVIE COMPLETE")
    print(f"  Every frame = f(t). No stored pixels.")
    print(f"  Running this script regenerates the identical film.")
    print(f"{'='*50}")


if __name__ == "__main__":
    main()


