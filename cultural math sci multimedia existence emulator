    # We'll create custom spirals per mug.
    for i, (cx, cy, ang) in enumerate(mug_positions):
        # Determine starting point for spiral: just outside the mug handle
        # The handle is on the outer side of the mug, we'll set start at (cx + 0.4, cy) rotated.
        start_x = cx + 0.5 * np.cos(ang)
