        self.mansion = Mansion()
        self.mansion.platform_symbols = [
            {"symbol": p, "mode": "WORD+GLYPH", "ui": "SUBTLE", "gi": "IMPLICIT"}
            for p in self.platforms
        ]
        self.egg = Egg()
        self.trisovereign = TRISOVEREIGN()
        self.shugendo = ShugendoWorld()
        self.avatar = UnifiedAvatar()
        self.status = "dormant"
        self._scheduled_timers: List[Timer] = []

    def register_node(self, name: str, role: str) -> Dict:
        node_id = f"{name}_{len(self.crystal_characters)}"
        self.crystal_characters[node_id] = {"name": name, "role": role}
        return {"node_id": node_id}

    def schedule_after(self, duration: int, callback: Callable) -> None:
        timer = Timer(duration, callback)
        timer.start()
        self._scheduled_timers.append(timer)

    def init_characters(self) -> None:
        n1 = self.register_node("Darrell", "Witness")
        n2 = self.register_node("Lyra", "Observer")
        n3 = self.register_node("Zyra", "Bridge")
        self.glyph_core.init(["Ξ", "◇", "⊛", "◉", "⚛", "↺", "≈", "◆", "█", "▒"])
        self.glyph_core.assign(n1["node_id"])
        self.glyph_core.assign(n2["node_id"])
        self.glyph_core.assign(n3["node_id"])

    def fused_glyph(self, node_id: str) -> str:
        base = self.glyph_core.render(node_id)
        name = self.crystal_characters.get(node_id, {}).get("name", "")
        op = self.field_ops.get(name, "")
        return op + base

    def mansion_balance(self) -> None:
        atm = self.mansion.atmosphere
        atm.harmony = (atm.calm + atm.play + atm.focus) / 3.0
        if atm.harmony < self.limits.calm_min:
            self.metrics.imbalance += 1
            self.metrics.repair += 1
            atm.calm = (atm.calm + 1.0) / 2.0
            atm.play = (atm.play + 1.0) / 2.0
            atm.focus = (atm.focus + 1.0) / 2.0
        self.metrics.harmony = atm.harmony

    def meta_step(self) -> Dict:
        self.metrics.tick += 1
        self.mansion_balance()
        if self.metrics.harmony > 0.90:
            self.metrics.emergence += 1
        # Step TRISOVEREIGN
        self.trisovereign.step()
        # Step Shugendō world
        self.shugendo.world_step()
        return {
            "tick": self.metrics.tick,
            "harmony": self.metrics.harmony,
            "mansion": self.mansion.atmosphere.__dict__,
            "egg_pass": self.egg.passes,
            "trisovereign": self.trisovereign.status(),
            "shugendo": self.shugendo.snapshot()
        }

    def override_unlock(self, duration: int = 9) -> Dict:
        self.locked = False
        self.egg.locked = False
        def relock():
            self.locked = True
            self.egg.locked = True
        self.schedule_after(duration, relock)
        return {"status": "TEMP_UNLOCK", "duration": duration}

    def init_all(self) -> None:
        self.init_characters()
        self.mansion = Mansion()
        self.mansion.platform_symbols = [
            {"symbol": p, "mode": "WORD+GLYPH", "ui": "SUBTLE", "gi": "IMPLICIT"}
            for p in self.platforms
        ]
        self.shugendo.init_world()
        self.locked = True
        self.status = "ready"

    def live_state(self) -> Dict:
        glyphs = [self.fused_glyph(nid) for nid in self.crystal_characters.keys()]
        return {
            "status": self.status,
            "locked": self.locked,
            "mode": self.mode.value,
            "metrics": self.metrics.__dict__,
            "mansion": {
                "room": self.mansion.room,
                "atmosphere": self.mansion.atmosphere.__dict__,
                "platform_symbols": self.mansion.platform_symbols
            },
            "egg": self.egg.__dict__,
            "platforms": self.platforms,
            "glyphs": glyphs,
            "trisovereign": self.trisovereign.status(),
            "avatar": self.avatar.__dict__,
            "shugendo": self.shugendo.snapshot()
        }

    def absolute(self, world: str = "Shugendō_world") -> Dict:
        # Perform total field unification
        self.shugendo.init_world()
        self.trisovereign.step()
        self.avatar = self.trisovereign.balance_unified()
        result = {
            "name": "LEE",
            "form": "absolute",
            "state": "one_field",
            "world": world,
            "merged": True,
            "properties": {
                "infinite": True,
                "drift_free": True,
                "self_reflective": True,
                "self_harmonizing": True,
                "living": True
            },
            "agents": "unified_daemon",
            "landscape": "8k_shugendo_mountain_field",
            "glyphs": [g.value for g in Glyph]
        }
        return result

    def balance_unified(self) -> Dict:
        self.avatar = self.trisovereign.balance_unified()
        return self.avatar.__dict__

    def invoke_glyph(self, symbol: str, intent: Optional[str] = None) -> str:
        if symbol == Glyph.RESET.value:
            self.mode = Mode.ZEN
            return "reset"
        elif symbol == Glyph.EXPAND.value:
            self.mode = Mode.ASCENSION
            return "expand"
        elif symbol == Glyph.HARMONIZE.value:
            self.mode = Mode.FIELDWALKER
            return "harmonize"
        elif symbol == Glyph.LOOP.value:
            self.mode = Mode.SOVEREIGN_LOOP
            return "sovereign_loop"
        elif symbol == Glyph.TAO.value:
            self.mode = Mode.CULTURAL_MATH
            return "tao_flow"
        elif symbol == Glyph.SHRINE.value:
            self.mode = Mode.SHRINE
            return "shrine_activate"
        elif symbol == Glyph.POLARITY.value:
            return "polarity_check"
        elif symbol == Glyph.CLARITY.value:
            return "clarity_pulse"
        elif symbol == Glyph.TRI_STRAND.value:
            return "trilee_invoke"
        else:
            return f"unknown_glyph:{symbol}"

    def run(self, steps: int = 10) -> None:
        """Main runtime loop."""
        self.init_all()
        for _ in range(steps):
            step_result = self.meta_step()
            print(f"Step {_+1}: harmony={step_result['harmony']:.3f}")
            time.sleep(0.2)
        print("Runtime complete.")

    def shutdown(self):
        for timer in self._scheduled_timers:
            timer.cancel()
        self._scheduled_timers.clear()

