                c = 'yellow' if fb>0.5 else 'orange' if fb>0.2 else 'red'
                ax.plot(fx2,fy2, '.', color=c, markersize=2.5, alpha=fb)
            for i in range(6):
                sx2 = cbx-0.3+i*0.25
                sy2 = cby+0.3+i*0.15
                sr2 = 0.15+0.15
                ax.add_patch(Circle((sx2,sy2), sr2, color='gray', alpha=max(0, 0.35-0.15)))

        if nar.capsule_state == "flying":
            ax.add_patch(Ellipse((cx4,cy4), 0.5, 0.3, angle=35, color='#8B7355'))
            ax.add_patch(Circle((cx4+0.06,cy4+0.03), 0.06, color='#4a9eff', alpha=0.8))
            self._felix(ax, cx4-0.03, cy4+0.22, t, "looking", s=0.18)
            for i in range(15):
                ex2 = cx4-0.4-i*0.08
                ey2 = cy4+0.03*math.sin(t*6+i*0.4)
                eb = max(0, 1-i/15)
                c = 'yellow' if eb>0.5 else 'orange' if eb>0.2 else 'red'
                ax.plot(ex2,ey2, '.', color=c, markersize=1.5, alpha=eb*0.6)

        for px4 in [1.0, 4.0, 5.5]:
            ax.add_patch(Rectangle((px4-0.15,2.0), 0.3, 0.8, color='#1a1a2a'))
            ax.add_patch(Circle((px4,2.95), 0.15, color='#1a1a2a'))

        self._grain(ax, 60, 0.05)
        return fig

    # ── Scene: Space ──
    def space(self, t, nar):
        fig, ax = plt.subplots(figsize=(4,4), dpi=100)
        fig.patch.set_facecolor('black')
        ax.set_xlim(0,10); ax.set_ylim(0,10); ax.axis('off')

        rng = np.random.default_rng(42)
        for i in range(120):
            sx3 = rng.uniform(0,10)
            sy3 = rng.uniform(0,10)
            sp = rng.uniform(0.3,2.5)
            ln = sp*0.6
            br = rng.uniform(0.2,1.0)
            ax.plot([sx3,sx3+ln], [sy3,sy3], 'white', linewidth=0.4, alpha=br*0.5)
            ax.plot(sx3,sy3, '.', color='white', markersize=br*1.5)

        cp = (t*0.3)%1.0
        if 0.1<cp<0.7:
            comet_x = 11-cp*15
            comet_y = 7+math.sin(cp*8)*1.0
            ax.add_patch(Circle((comet_x,comet_y), 0.15, color='white'))
            for dx2 in range(1,12):
                ta2 = max(0, 1-dx2/12)
                ax.plot(comet_x+dx2*0.12, comet_y+dx2*0.03, '.', color='white',
                       markersize=0.8, alpha=ta2*0.4)

        self._felix(ax, nar.felix_x, nar.felix_y, nar.felix_phase, "floating", s=0.8)

        cap = Ellipse((nar.capsule_x,nar.capsule_y), 0.5, 0.3, angle=15, color='#8B7355', alpha=0.7)
        ax.add_patch(cap)

        for i in range(15):
            ex3 = nar.capsule_x-0.4-i*0.08
            ey3 = nar.capsule_y+0.03*math.sin(t*6+i*0.4)
            eb = max(0, 1-i/15)
            c = 'yellow' if eb>0.5 else 'orange' if eb>0.2 else 'red'
            ax.plot(ex3,ey3, '.', color=c, markersize=1.5, alpha=eb*0.6)

        ax.add_patch(Circle((2,8), 1.5, color='#4a2a6a', alpha=0.08))
        ax.add_patch(Circle((8,3), 1.2, color='#2a4a6a', alpha=0.06))

        self._grain(ax, 70, 0.03)
        return fig

    # ── Scene: Impact ──
    def impact(self, t, nar):
        fig, ax = plt.subplots(figsize=(4,4), dpi=100)
        fig.patch.set_facecolor('black')
        ax.set_xlim(0,10); ax.set_ylim(0,10); ax.axis('off')

        mcx, mcy, mr = 5.5, 5.0, 2.5
        ax.add_patch(Circle((mcx,mcy), mr, color='#e8e8d0'))
        for ang in np.linspace(0, 2*np.pi, 50):
            for rf in np.linspace(0,1,4):
                px5 = mcx+mr*rf*math.cos(ang)
                py5 = mcy+mr*rf*math.sin(ang)
                sh = 0.5+0.5*math.cos(ang)
                ax.plot(px5,py5, '.', color=str(0.25*sh), markersize=1, alpha=0.25)

        elx = mcx-mr*0.35
        ey5 = mcy+mr*0.1
        erx = mcx+mr*0.35
        for ex5 in [elx, erx]:
            ax.add_patch(Ellipse((ex5,ey5), 0.8, 0.5, color='#2a2a2a'))
            ax.add_patch(Circle((ex5,ey5), 0.18, color='white'))

        ax.plot([mcx,mcx+0.1], [mcy-mr*0.1, mcy-mr*0.3], '#8a8a70', linewidth=2)
        my5 = mcy-mr*0.4
        mx5 = np.linspace(mcx-0.5, mcx+0.5, 30)
        impact_t = t - self.cfg.duration*0.72
        mc5 = my5 + (0.1 if impact_t>0 else -0.1)*np.sin(np.linspace(0,np.pi,30))
        ax.plot(mx5, mc5, '#5a5a4a', linewidth=2)

        if impact_t > 0:
            dr = 0.2+impact_t*0.6
            ax.add_patch(Circle((elx,ey5), dr, color='black'))
            for ang2 in np.linspace(0,2*np.pi,8):
                ll = dr*1.5
                ax.plot([elx,elx+ll*math.cos(ang2)], [ey5,ey5+ll*math.sin(ang2)], 'black', linewidth=1.5)
            if impact_t < 0.5:
                fr = impact_t*5
                ax.add_patch(Circle((elx,ey5), fr, color='yellow', alpha=max(0,1-impact_t*2)))
            self._felix(ax, elx, ey5+0.3, t, "popping_out", s=0.15)
        elif nar.capsule_state == "approaching":
            it2 = (t - self.cfg.duration*0.72) / (self.cfg.duration*0.13*0.6)
            it2 = min(it2, 1.0)
            cap_x2 = -1+it2*(elx+1)
            cap_y2 = 9-it2*(9-ey5)
            ax.add_patch(Ellipse((cap_x2,cap_y2), 0.4, 0.25, angle=30, color='#8B7355'))
            self._felix(ax, cap_x2-0.05, cap_y2+0.2, t, "standing", s=0.15)
            for i in range(6):
                tx4 = cap_x2-i*0.12
                ty4 = cap_y2+i*0.08
                ax.plot(tx4,ty4, '.', color='white', markersize=0.8, alpha=0.4*(1-i/6))

        if 0<impact_t<0.8:
            if int(impact_t*6)%2:
                ax.set_xlim(0.15,10.15)
                ax.set_ylim(-0.15,9.85)

        self._grain(ax, 60, 0.05)
        return fig

    # ── Scene: Lunar Surface ──
    def surface(self, t, nar):
        fig, ax = plt.subplots(figsize=(4,4), dpi=100)
        fig.patch.set_facecolor('black')
        ax.set_xlim(0,10); ax.set_ylim(0,10); ax.axis('off')
        self._stars(ax, 100)

        for x2 in range(10):
            hill = 3.0+0.4*math.sin(x2*0.8)+0.2*math.sin(x2*2.1)
            ax.fill_between([x2,x2+1], [hill,hill+0.1], [0,0], color='#4a4a5a', alpha=0.6)

        for crx,cry,crr in [(1.5,2.5,0.5),(5.0,2.0,0.7),(8.0,2.3,0.4)]:
            ax.add_patch(Circle((crx,cry), crr, color='#3a3a4a'))
            ax.add_patch(Circle((crx,cry), crr+0.08, fill=False, edgecolor='#5a5a6a', linewidth=1))

        ax.add_patch(Circle((8.5,8.0), 0.4, color='#4a7aaa', alpha=0.7))
        ax.add_patch(Circle((8.5,8.0), 0.4, fill=False, edgecolor='#6a9aca', linewidth=1))

        self._felix(ax, nar.felix_x, nar.felix_y, nar.felix_phase, "moon_walk", s=0.8)

        fp = np.arange(0.5, nar.felix_x, 0.4)
        for i, fpx in enumerate(fp):
            a = max(0, 0.3-i*0.02)
            ax.add_patch(Circle((fpx,2.7), 0.06, color='#5a5a6a', alpha=a))

        ax.add_patch(Ellipse((8.5,2.8), 0.6, 0.35, angle=-10, color='#8B7355'))
        ax.add_patch(Circle((8.55,2.82), 0.06, color='#4a9eff', alpha=0.6))

        fx3 = 2.0
        ax.plot([fx3,fx3], [3.0,4.5], '#aaa', linewidth=1.5)
        ax.add_patch(Polygon([(fx3,4.5),(fx3+0.6,4.35),(fx3,4.2)], color='#cc3333'))

        self._grain(ax, 60, 0.04)
        return fig

    # ── Scene: Felix waves from Moon ──
    def wave(self, t, nar):
        fig, ax = plt.subplots(figsize=(4,4), dpi=100)
        fig.patch.set_facecolor('black')
        ax.set_xlim(0,10); ax.set_ylim(0,10); ax.axis('off')
        self._stars(ax, 100)

        for x2 in range(10):
            hill = 3.0+0.3*math.sin(x2*0.8)
            ax.fill_between([x2,x2+1], [hill,hill+0.1], [0,0], color='#4a4a5a', alpha=0.6)

        ax.add_patch(Circle((8.5,8.0), 0.5, color='#4a7aaa', alpha=0.7))
        ax.add_patch(Circle((8.5,8.0), 0.5, fill=False, edgecolor='#6a9aca', linewidth=1))

        self._felix(ax, 5.0, 3.5, nar.felix_phase, "waving", s=1.2)

        fx4 = 2.0
        ax.plot([fx4,fx4], [3.0,4.5], '#aaa', linewidth=1.5)
        ax.add_patch(Polygon([(fx4,4.5),(fx4+0.6,4.35),(fx4,4.2)], color='#cc3333'))

        self._grain(ax, 60, 0.04)
        return fig


def render(cfg):
    nar = Narrative(cfg)
    ren = Renderer(cfg)
    frames = []
    dt = 1.0 / cfg.fps
    total = cfg.total_frames

    print(f"Rendering {total} frames ({cfg.duration}s @ {cfg.fps}fps)...")

    for i in range(total):
        t = i * dt
        nar.update(t, dt)
        p = nar.phase(t)

        if p == "city":        fig = ren.city(t, nar)
        elif p == "attic":     fig = ren.attic(t, nar)
        elif p == "congress":  fig = ren.congress(t, nar)
        elif p == "launch":    fig = ren.launch(t, nar)
        elif p == "space":     fig = ren.space(t, nar)
        elif p == "impact":    fig = ren.impact(t, nar)
        elif p == "surface":   fig = ren.surface(t, nar)
        elif p == "wave":      fig = ren.wave(t, nar)
        else:                  fig = ren.city(t, nar)

        fig.canvas.draw()
        buf = fig.canvas.buffer_rgba()
        frames.append(np.asarray(buf)[:,:,:3].copy())
        plt.close(fig)

        if (i+1)%12==0 or i==total-1:
            print(f"  [{i+1:3d}/{total}] {p:10s} t={t:.1f}s")

    return frames


def save_gif(frames, path, fps):
    import imageio
    imageio.mimsave(path, frames, duration=1.0/fps, loop=0)
    print(f"\n  GIF: {path} ({len(frames)} frames, {len(frames)/fps:.1f}s)")


def save_mp4(frames, path, fps):
    mp4 = path.replace('.gif','.mp4')
    h, w = frames[0].shape[:2]
    cmd = ['ffmpeg','-y','-f','rawvideo','-vcodec','rawvideo',
           '-pix_fmt','rgb24','-s',f'{w}x{h}','-r',str(fps),
           '-i','-','-c:v','libx264','-pix_fmt','yuv420p','-crf','18',mp4]
    proc = subprocess.Popen(cmd, stdin=subprocess.PIPE, stderr=subprocess.PIPE)
    for f in frames:
        proc.stdin.write(f.tobytes())
    proc.stdin.close()
    proc.wait()
    if proc.returncode == 0:
        print(f"  MP4: {mp4}")
    else:
        print(f"  MP4 error")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--output", default="trip_felix_moon.gif")
    ap.add_argument("--duration", type=float, default=28.0)
    ap.add_argument("--fps", type=int, default=12)
    ap.add_argument("--mp4", action="store_true")
    ap.add_argument("--seed", type=int, default=42)
    args = ap.parse_args()

    cfg = FilmConfig(fps=args.fps, duration=args.duration,
                     output=args.output, seed=args.seed)

    print("Trip to the Moon + Felix the Cat — No Text Edition")
    print(f"{cfg.width}x{cfg.height} | {cfg.fps}fps | {cfg.duration}s | {cfg.total_frames} frames")

    frames = render(cfg)
    print("\nSaving...")
    save_gif(frames, cfg.output, cfg.fps)
    if args.mp4:
        save_mp4(frames, cfg.output, cfg.fps)
    print("Done.")


if __name__ == "__main__":
    main()

#!/usr/bin/env python3
"""
EXECUTABLE CINEMA — Combined Program-Movie
===========================================
Combines:
  • A Trip to the Moon (1902) — title cards, congress, launch, space, impact, surface
  • Felix the Cat (1920s) — walking animation, state machine, dialogue
  • Bird of Paradise (1932) — tropical waves, ritual dancer, fractal foliage

Architecture:
  frame(t) = render(scene[t], characters[t], dialogue[t], audio[t])
  Every frame is a function call. No stored pixels. Deterministic.

Output: GIF + MP4 via matplotlib + imageio (all open source).

Usage:
    python executable_cinema_combined.py                    # renders GIF
    python executable_cinema_combined.py --output film.gif  # custom output
    python executable_cinema_combined.py --duration 20      # seconds
    python executable_cinema_combined.py --fps 12           # framerate
    python executable_cinema_combined.py --preview          # show live
"""

import argparse
import math
import os
import sys
from dataclasses import dataclass, field
from typing import Dict, List, Optional, Tuple

import numpy as np
import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt
import matplotlib.patches as patches
from matplotlib.patches import FancyBboxPatch, Circle, Ellipse
from matplotlib.collections import LineCollection
import matplotlib.collections as mcoll

# ─── Configuration ──────────────────────────────────────────────────────────

@dataclass
class FilmConfig:
    width: int = 400
    height: int = 400
    fps: int = 12
    duration: float = 15.0
    output: str = "executable_cinema.gif"
    seed: int = 42

    @property
    def total_frames(self) -> int:
        return int(self.duration * self.fps)


# ─── Narrative State Machine (Micro-Level: Characters as State Machines) ────

@dataclass
class CharacterState:
    name: str
    state: str = "idle"
    position: Tuple[float, float] = (0.0, 0.0)
    velocity: Tuple[float, float] = (0.0, 0.0)
    animation_phase: float = 0.0
    dialogue: str = ""
    dialogue_time: float = 0.0

    def update(self, t: float, dt: float):
        self.position = (
            self.position[0] + self.velocity[0] * dt,
            self.position[1] + self.velocity[1] * dt,
        )
        self.animation_phase = t

class NarrativeEngine:
    """
    Micro-level narrative: plot = recursive loop of conflict → resolution → collapse.
    Characters are state machines. Dialogue is a timestamped stream.
    """

    # Dialogue stream: {(time_start, time_end): "text"}
    DIALOGUE_STREAM = {
        (0.0, 2.5): "A TRIP TO THE MOON",
        (2.5, 4.0): "Felix: I have a dream!",
        (4.0, 6.0): "Tropical chanting echoes...",
        (6.0, 8.0): "The capsule launches!",
        (8.0, 10.0): "Felix walks through the stars",
        (10.0, 12.0): "The dancer spins in ritual",
        (12.0, 14.0): "IMPACT — The Moon screams!",
        (14.0, 15.0): "FIN",
    }

    def __init__(self, config: FilmConfig):
        self.config = config
        self.felix = CharacterState(
            name="Felix",
            state="walking",
            position=(1.0, 5.0),
            velocity=(0.15, 0.0),
        )
        self.dancer = CharacterState(
            name="Dancer",
            state="ritual_motion",
            position=(5.0, 5.0),
        )
        self.capsule = CharacterState(
            name="Capsule",
            state="grounded",
            position=(2.0, 3.0),
        )
        self.state = "title"

    def get_scene_phase(self, t: float) -> str:
        """Determine which scene module is active at time t."""
        dur = self.config.duration
        if t < dur * 0.15:
            return "title_card"
        elif t < dur * 0.30:
            return "felix_walk"
        elif t < dur * 0.45:
            return "bird_ritual"
        elif t < dur * 0.55:
            return "launch"
        elif t < dur * 0.70:
            return "space_travel"
        elif t < dur * 0.85:
            return "impact"
        else:
            return "fin"

    def get_dialogue(self, t: float) -> str:
        for (t0, t1), text in self.DIALOGUE_STREAM.items():
            if t0 <= t < t1:
                return text
        return ""

    def update(self, t: float, dt: float):
        phase = self.get_scene_phase(t)
        self.state = phase

        if phase == "felix_walk":
            self.felix.state = "walking"
            self.felix.velocity = (0.15, 0.0)
            self.felix.update(t, dt)
            if self.felix.position[0] > 9.0:
                self.felix.position = (1.0, 5.0)
        elif phase == "bird_ritual":
            self.dancer.state = "ritual_motion"
        elif phase == "launch":
            self.capsule.state = "launching"
            launch_t = (t - self.config.duration * 0.45) / (self.config.duration * 0.10)
            self.capsule.position = (2.0 + launch_t * 6.0, 3.0 + launch_t * 4.0)
        elif phase == "impact":
            self.capsule.state = "crashed"
            self.capsule.position = (7.0, 6.5)


# ─── Scene Modules (Micro-Level: Environment as Procedural Geometry) ───────

class SceneRenderer:
    """Each scene is a module that generates environment geometry procedurally."""

    def __init__(self, config: FilmConfig):
        self.config = config
        self.rng = np.random.default_rng(config.seed)

    def _add_film_grain(self, ax, intensity=0.03):
        """Procedural film grain overlay."""
        for _ in range(80):
            x = self.rng.uniform(0, 10)
            y = self.rng.uniform(0, 10)
            b = self.rng.uniform(0, intensity)
            ax.plot(x, y, '.', color=str(b), markersize=1, alpha=0.5)

    def _add_vignette(self, fig):
        """Dark vignette corners."""
        ax = fig.add_axes([0, 0, 1, 1], polar=False, facecolor='none')
        ax.set_xlim(0, 10)
        ax.set_ylim(0, 10)
        ax.axis('off')
        for corner_x, corner_y in [(0, 0), (0, 10), (10, 0), (10, 10)]:
            circle = plt.Circle((corner_x, corner_y), 6, color='black', alpha=0.4)
            ax.add_patch(circle)
        return ax

    def render_title_card(self, t: float, text: str) -> plt.Figure:
        """Silent film intertitle — white text on black with ornate border."""
        fig, ax = plt.subplots(figsize=(4, 4), dpi=100)
        fig.patch.set_facecolor('black')
        ax.set_xlim(0, 10)
        ax.set_ylim(0, 10)
        ax.axis('off')

        # Ornate border
        for offset in [0.3, 0.5]:
            rect = plt.Rectangle((offset, offset), 10 - 2*offset, 10 - 2*offset,
                                fill=False, edgecolor='white', linewidth=1.5, alpha=0.6)
            ax.add_patch(rect)

        # Corner decorations
        for cx, cy in [(0.8, 0.8), (0.8, 9.2), (9.2, 0.8), (9.2, 9.2)]:
            ax.plot(cx, cy, 'o', color='white', markersize=4, alpha=0.7)

        # Text with fade
        progress = (t % 2.5) / 2.5
        alpha = min(progress * 3, 1.0, (1.0 - progress) * 3)
        ax.text(5, 5.5, text, fontsize=14, color='white', alpha=alpha,
               ha='center', va='center', fontweight='bold',
               fontfamily='serif')
        ax.text(5, 4.5, "— 1902 —", fontsize=9, color='white', alpha=alpha * 0.6,
               ha='center', va='center', fontfamily='serif')

        self._add_film_grain(ax, 0.05)
        return fig

    def render_felix_scene(self, t: float, character: CharacterState) -> plt.Figure:
        """Felix the Cat walking across a simple landscape."""
        fig, ax = plt.subplots(figsize=(4, 4), dpi=100)
        fig.patch.set_facecolor('white')
        ax.set_xlim(0, 10)
        ax.set_ylim(0, 10)
        ax.axis('off')

        # Sky gradient (horizontal lines)
        for y in np.linspace(7, 10, 15):
            alpha = (y - 7) / 3.0 * 0.3
            ax.axhspan(y, y + 0.2, color='#87CEEB', alpha=alpha)

        # Ground
        ax.fill_between([0, 10], [0, 0], [2.5, 2.5], color='#8B7355', alpha=0.6)
        ax.plot([0, 10], [2.5, 2.5], color='#654321', linewidth=2)

        # Grass tufts
        for gx in np.linspace(0, 10, 20):
            h = 0.3 + 0.2 * math.sin(gx * 3)
            ax.plot([gx, gx - 0.1], [2.5, 2.5 + h], color='green', linewidth=1)
            ax.plot([gx, gx + 0.1], [2.5, 2.5 + h * 0.8], color='green', linewidth=1)

        # Felix character
        fx, fy = character.position
        phase = character.animation_phase

        # Body (black ellipse)
        body = Ellipse((fx, fy), 1.2, 1.8, color='black')
        ax.add_patch(body)

        # Head
        head = Circle((fx, fy + 1.3), 0.6, color='black')
        ax.add_patch(head)

        # Ears (triangles)
        ear_l = plt.Polygon([(fx - 0.4, fy + 1.7), (fx - 0.2, fy + 2.3), (fx, fy + 1.7)],
                           color='black')
        ear_r = plt.Polygon([(fx + 0.4, fy + 1.7), (fx + 0.2, fy + 2.3), (fx, fy + 1.7)],
                           color='black')
        ax.add_patch(ear_l)
        ax.add_patch(ear_r)

        # Eyes (white with black pupils)
        ax.add_patch(Circle((fx - 0.2, fy + 1.4), 0.15, color='white'))
        ax.add_patch(Circle((fx + 0.2, fy + 1.4), 0.15, color='white'))
        pupil_offset = 0.03 * math.sin(phase * 3)
        ax.add_patch(Circle((fx - 0.2 + pupil_offset, fy + 1.4), 0.06, color='black'))
        ax.add_patch(Circle((fx + 0.2 + pupil_offset, fy + 1.4), 0.06, color='black'))

        # Mouth (smile)
        mouth_x = np.linspace(fx - 0.15, fx + 0.15, 20)
        mouth_y = fy + 1.1 + 0.05 * np.sin(np.linspace(0, np.pi, 20))
        ax.plot(mouth_x, mouth_y, 'white', linewidth=1.5)

        # Legs (animated walk cycle)
        leg_phase = phase * 4
        for leg_sign, leg_name in [(-1, 'left'), (1, 'right')]:
