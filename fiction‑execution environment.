class Ledger:
    def __init__(self):
        self.entries = []

    def log(self, event, data):
        self.entries.append({
            "event": event,
            "ts": datetime.utcnow().isoformat(),
            "data": data
        })

    def dump(self) -> str:
        return json.dumps(self.entries, indent=2)


