class ChemoSimulator:
    """
    Flat Chemo-SN interpreter.

    - Reads a Chemo-SN spec (dict)
    - Keeps current state per species
    - Uses reaction 'pathway' lists to advance states
    - Logs every transition with timestamp and shape
    """

    def __init__(self, spec: dict):
        self.spec = spec
        self.time = 0
        self.log = []

        # Index species states: states[species_id][state_id] -> state_dict
        self.states = {
            sp["id"]: {s["id"]: s for s in sp.get("states", [])}
            for sp in spec.get("species", [])
        }

        # Current state per species
        self.current = dict(spec.get("initial_state", {}))

        # Reactions list (each reaction has shape + pathway)
        self.reactions = spec.get("reactions", [])

    def _log(self, event: str, data: dict):
        self.log.append(
            {
                "t": self.time,
                "ts": datetime.utcnow().isoformat(),
                "event": event,
                "data": data,
            }
        )

    def step(self):
        """
        One flat Chemo-SN step:
        - For each reaction, if current state matches a 'from_state',
          advance to 'to_state' according to its shape/pathway.
        """
        self.time += 1

        for rxn in self.reactions:
            species_id = rxn["species"]
            shape = rxn.get("shape", "flat")
            pathway = rxn.get("pathway", [])

            cur = self.current.get(species_id)
            if cur is None:
                continue

            # Simple deterministic behavior: first matching pathway entry
            for step in pathway:
                if step["from_state"] == cur:
                    new_state = step["to_state"]
                    self._log(
                        "transition",
                        {
                            "reaction": rxn["id"],
                            "species": species_id,
                            "shape": shape,
                            "from": cur,
                            "to": new_state,
                        },
                    )
                    self.current[species_id] = new_state
                    break  # one transition per reaction per step

    def run(self, steps: int):
        for _ in range(steps):
            self.step()
        return {
            "final_state": self.current,
            "log": self.log,
        }


