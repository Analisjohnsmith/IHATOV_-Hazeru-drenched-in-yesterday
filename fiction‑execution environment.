class WeedNode:
    def __init__(self, name, traits, payloads, ledger):
        self.name = name
        self.traits = traits
        self.payloads = payloads
        self.idx = 0
        self.seal = "O!INFINITY"
        self.ledger = ledger

    def state(self) -> str:
        return self.traits[self.idx % len(self.traits)]

    def echo(self, payload=None):
        safe = payload or random.choice(self.payloads)
        rec = {"weed": self.name, "state": self.state(), "echo": safe, "seal": self.seal}
        self.ledger.log("echo", {"rec": rec, "hash": sha(rec)})
        return rec

    def flip(self):
        pre = self.state()
        self.idx = (self.idx + 1) % len(self.traits)
        post = self.state()
        rec = {"weed": self.name, "pre": pre, "post": post, "seal": self.seal}
        self.ledger.log("flip", {"rec": rec, "hash": sha(rec)})
        return rec

    def rupture(self, tag):
        pre = {"weed": self.name, "tag": tag, "pre_state": self.state(), "seal": self.seal}
        self.ledger.log("rupture_hit", {"rec": pre, "hash": sha(pre)})
        self.flip()
        post = {"weed": self.name, "tag": tag, "post_state": self.state(), "seal": self.seal}
        self.ledger.log("rupture_post", {"rec": post, "hash": sha(post)})
        return post

    def invariants(self):
        ok = self.seal == "O!INFINITY"
        rec = {"weed": self.name, "seal_ok": ok, "state": self.state()}
        self.ledger.log("invariants", {"rec": rec, "hash": sha(rec)})
        return ok


