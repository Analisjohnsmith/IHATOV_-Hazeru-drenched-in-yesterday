FORBIDDEN = 42  # the constant


def deg42():
    return math.radians(FORBIDDEN)  # 7 * pi / 30


def pow42():
    """
    42^(1 degree) as the disharmonic scaling factor.
    = 42^(pi/180) ~= 1.0837
    """
    return FORBIDDEN ** (math.pi / 180.0)


def mod42(x):
    return x % FORBIDDEN


def scale42(x):
    return FORBIDDEN * x


def root42(x):
    return x ** (1.0 / FORBIDDEN)


def branch_angle():
    return 360.0 / FORBIDDEN  # ~8.571428 degrees


def harmonic_tone(f0, n):
    """42-tone equal temperament: f0 * 2^(n/42)."""
    return f0 * (2 ** (n / FORBIDDEN))


def sovereign_angle(n):
    return FORBIDDEN * n


