ub = np.concatenate([np.ones(D)*10.0, np.ones(D)*1.1, np.array([5.0, 1.0, 5.0])])

res = least\_squares(residuals, p0, boundslb, ub),

argst, Y\_obs, MI, S, C, Phi, F\_m),

