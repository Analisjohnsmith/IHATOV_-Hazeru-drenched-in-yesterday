def make\_xj(t, r0, k, n, phi\_offset, Fm):

\# real-valued x\_j(t)

theta = 2*np.pi * t / BreathPeriod + phi\_offset

return r0  (k*n)  np.cos(theta)  Fm

\section*{\# pack params into vector p = [r0\_1..r0\_D, k\_1..k\_D, lambda, mu, eta]}

def residuals(p, t, Y\_obs, MI, S, C, Phi, F\_m):

D = MI.shape[0]

r0 = p[0]

k  = p[D:2*D]

lam = p[-3]

mu  = p[-2]

